{
  "name": "@sinameraji/tpm",
  "version": "1.2.0-beta.4",
  "description": "Technical Product Manager CLI — audits software products via a deterministic six-stage pipeline on Claude (BYO Anthropic key).",
  "keywords": [
    "pm",
    "audit",
    "product-management",
    "cli",
    "anthropic",
    "claude"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://tpm-d3h.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinameraji/tpm"
  },
  "bugs": {
    "url": "https://github.com/sinameraji/tpm/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tpm": "dist/bin/tpm.js"
  },
  "files": [
    "dist",
    "src/patterns/built-in.yaml"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "prepublishOnly": "pnpm run build && pnpm run bundle",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node ./dist/bin/tpm.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tpm/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
