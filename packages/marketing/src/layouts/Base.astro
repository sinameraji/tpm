---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "TPM — open-source Technical Product Manager CLI. Audits software products via a deterministic six-stage pipeline." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://usetpm.dev/" />
  <link rel="canonical" href="https://usetpm.dev/" />
  <style>
    :root {
      --bg: #fafaf7;
      --fg: #1a1a1a;
      --muted: #4d4d4d;
      --border: #e4e4e0;
      --brand: #0654ba;
      --brand-dark: #0345a0;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", "Helvetica Neue", sans-serif;
      line-height: 1.55;
      color: var(--fg);
      background: var(--bg);
    }
    header, main, footer {
      max-width: 64rem;
      margin: 0 auto;
      padding: 1.5rem 1.5rem;
    }
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    header .brand {
      font-weight: 700;
      color: var(--brand);
      letter-spacing: 0.02em;
      text-decoration: none;
    }
    header nav a {
      margin-left: 1.25rem;
      color: var(--muted);
      text-decoration: none;
      font-size: 0.92rem;
    }
    header nav a:hover { color: var(--fg); }
    footer {
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.88rem;
      padding-top: 2rem;
      padding-bottom: 3rem;
    }
    footer a { color: var(--muted); }
    footer .credits {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 0.5rem;
      font-size: 0.82rem;
    }
    .button {
      display: inline-block;
      background: var(--brand);
      color: white;
      text-decoration: none;
      padding: 0.65rem 1.25rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .button:hover { background: var(--brand-dark); }
    .button.secondary {
      background: transparent;
      color: var(--brand);
      border: 1px solid var(--brand);
    }
    .button.secondary:hover { background: var(--brand); color: white; }
    code, pre {
      font-family: "SF Mono", "Menlo", monospace;
      font-size: 0.9em;
      background: #efefe9;
      border-radius: 4px;
      padding: 1px 6px;
    }
    pre {
      padding: 1rem;
      overflow-x: auto;
    }
    .badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #efefe9;
      color: var(--muted);
      padding: 2px 8px;
      border-radius: 999px;
      vertical-align: middle;
      margin-left: 0.5rem;
    }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand">TPM · Technical Product Manager</a>
    <nav>
      <a href="/docs">Docs</a>
      <a href="/self-host">Self-host</a>
      <a href="https://github.com/sinameraji/tpm">GitHub</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>
      TPM is open source (MIT). Built by <a href="https://github.com/sinameraji">Sina Meraji</a>.
    </p>
    <div class="credits">
      <a href="https://x.com/sinasanm">x.com/sinasanm</a>
      <a href="https://github.com/sinameraji">github.com/sinameraji</a>
      <a href="https://linkedin.com/in/sinameraji">linkedin.com/in/sinameraji</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </footer>
</body>
</html>
